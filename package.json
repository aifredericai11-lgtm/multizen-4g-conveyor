{
  "name": "multizen-4g-conveyor",
  "version": "2.1.0",
  "description": "Esteira 4G Completa de Criacao & Aquecimento: Rotacao 4G ADB (1 Conta = 1 IP Exclusivo), Ponte IPv4 Pura (:8082), Dual-GPU Zero-CDP Gmail/Outlook Creator, Aquecimento Perfil 2-3d, 10 Paginas (~5m+2m offline mesmo-IP + 67 Paises Bloqueados) e Aquecimento Ideal 7d (Post Cruzado MBS EN + Story 2.2s + Collab)",
  "main": "multizen.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "infra:status": "node modules/infra_4g/runner.js",
    "infra:rotate": "node modules/infra_4g/runner.js --rotate",
    "infra:bridge": "node modules/infra_4g/zerum_adspower_4g_bridge.js",
    "warmup:help": "node modules/account_warmup/runner.js --help",
    "warmup:step1": "node modules/account_warmup/runner.js --create-step1",
    "warmup:status": "node modules/account_warmup/runner.js --pipeline",
    "warmup:conveyor": "node -e \"require('./modules/account_warmup/willas_page_warmer').runWillasFullWarmupConveyor({}, (l,m)=>console.log('['+l+'] '+m))\""
  },
  "dependencies": {
    "puppeteer-core": "^25.14.0",
    "rebrowser-puppeteer-core": "^25.14.101",
    "ws": "^8.22.0"
  }
}
