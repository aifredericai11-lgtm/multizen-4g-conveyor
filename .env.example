# ============================================================================
# MultiZen 4G Conveyor — Variáveis de Ambiente (.env.example)
# Copie para `.env` localmente (NUNCA faça commit do `.env` real)
# ============================================================================

# IP público fixo da rede residencial/fibra do PC host (usado para detectar e bloquear vazamentos fora do 4G)
MATRIX_FIXED_IP=
MATRIX_FIXED_IPV6_PREFIX=

# Interface Ethernet local opcional para checagem direta do IP fixo (ex: 192.168.1.100)
DIRECT_ETHERNET_INTERFACE=

# UUID opcional do perfil Matriz autorizado a rodar em IP fixo residencial
MATRIX_PROFILE_UUID=00000000-0000-0000-0000-000000000004

# Portas locais do túnel 4G (Every Proxy via ADB forward :8080 -> Ponte IPv4 Pura :8082)
PROXY_4G_HOST=127.0.0.1
PROXY_4G_PORT=8080
IPV4_BRIDGE_PORT=8082

# Porta do emulador local compatível com API AdsPower V1/V2
ZERUM_ADSPOWER_PORT=50325

# Chave mestra opcional para o cofre AES-256-GCM local (.env.vault.json)
HUB_MASTER_KEY=
